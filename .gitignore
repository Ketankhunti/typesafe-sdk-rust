# Rust build artifacts
/target/
**/*.rs.bk
*.pdb

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Environment files (never commit secrets)
.env
.env.*
!.env.example

# Cargo lock — this is a library crate, so we commit Cargo.lock
# See: https://doc.rust-lang.org/cargo/faq.html#why-do-binaries-have-cargolock-in-version-control-but-not-libraries
# We keep it for reproducible builds of the examples and tests.
